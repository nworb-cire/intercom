<configuration name="event_socket.conf" description="Intercom event socket">
  <settings>
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="__INTERCOM_ESL_PASSWORD__"/>
    <!-- The socket is reachable only on the private bridge and requires a strong password. -->
    <param name="apply-inbound-acl" value="any_v4.auto"/>
  </settings>
</configuration>
